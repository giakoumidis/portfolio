# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# content inbox — private docs + heavy raw media (keep locally, don't commit)
/content-inbox/

# local scratch / backups (not part of the site)
/backups/
/portfolio/
*.xlsx
AGENT_REPORT.md
publications.md

# drop zone after processing (optional local leftovers)
/uncategorized/
