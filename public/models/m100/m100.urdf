<?xml version="1.0"?>
<!-- Visual-only DJI Matrice 100, derived from dji_m100_description (MIT).
     Body without rotors; four spinning props + 3-DOF gimbal. Collision/inertial
     stripped for web. Runtime materials in RobotStage may override these. -->
<robot name="dji_m100">
  <material name="body">
    <color rgba="0.223529 1 0.54902 1"/>
  </material>
  <material name="accent">
    <color rgba="0 0.941176 1 1"/>
  </material>
  <material name="gimbal">
    <color rgba="0.545098 0.168627 0.835294 1"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/body.stl"/></geometry>
      <material name="body"/>
    </visual>
  </link>

  <!-- Rotors — positions from dji_m100_base.xacro (arm 0.17 m, z offset 0.1 m). -->
  <link name="rotor_0">
    <visual>
      <geometry>
        <mesh filename="meshes/propeller_ccw.dae" scale="0.195 0.195 0.195"/>
      </geometry>
      <material name="accent"/>
    </visual>
  </link>
  <joint name="rotor_0_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_0"/>
    <origin xyz="0.240417 -0.240417 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="rotor_1">
    <visual>
      <geometry>
        <mesh filename="meshes/propeller_ccw.dae" scale="0.195 0.195 0.195"/>
      </geometry>
      <material name="accent"/>
    </visual>
  </link>
  <joint name="rotor_1_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_1"/>
    <origin xyz="-0.240417 0.240417 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="rotor_2">
    <visual>
      <geometry>
        <mesh filename="meshes/propeller_cw.dae" scale="0.195 0.195 0.195"/>
      </geometry>
      <material name="accent"/>
    </visual>
  </link>
  <joint name="rotor_2_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_2"/>
    <origin xyz="0.240417 0.240417 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="rotor_3">
    <visual>
      <geometry>
        <mesh filename="meshes/propeller_cw.dae" scale="0.195 0.195 0.195"/>
      </geometry>
      <material name="accent"/>
    </visual>
  </link>
  <joint name="rotor_3_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_3"/>
    <origin xyz="-0.240417 -0.240417 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- 3-DOF gimbal (Zenmuse-style payload bay). -->
  <link name="gimbal_roll_link"/>
  <joint name="gimbal_roll_joint" type="revolute">
    <parent link="base_link"/>
    <child link="gimbal_roll_link"/>
    <origin xyz="0.05 0 -0.04" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.48" upper="0.48" effort="0" velocity="0.2"/>
  </joint>

  <link name="gimbal_pitch_link"/>
  <joint name="gimbal_pitch_joint" type="revolute">
    <parent link="gimbal_roll_link"/>
    <child link="gimbal_pitch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.48" upper="0.48" effort="0" velocity="0.2"/>
  </joint>

  <link name="gimbal_yaw_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/gimbal.stl"/></geometry>
      <material name="gimbal"/>
    </visual>
  </link>
  <joint name="gimbal_yaw_joint" type="revolute">
    <parent link="gimbal_pitch_link"/>
    <child link="gimbal_yaw_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="0" velocity="0.2"/>
  </joint>
</robot>
