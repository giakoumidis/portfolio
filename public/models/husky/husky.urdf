<?xml version="1.0"?>
<!-- Visual-only Husky A200, derived from husky_description (BSD-3-Clause, Clearpath Robotics).
     Meshes decimated for web; materials from site palette (green / amber / dark).
     Runtime materials in RobotStage may still override these. -->
<robot name="husky">
  <material name="body">
    <color rgba="0.223529 1 0.54902 1"/>
  </material>
  <material name="accent">
    <color rgba="1 0.701961 0.278431 1"/>
  </material>
  <material name="dark">
    <color rgba="0.07451 0.101961 0.180392 1"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/base_link.stl"/></geometry>
      <material name="body"/>
    </visual>
  </link>

  <link name="top_chassis_link">
    <visual>
      <geometry><mesh filename="meshes/top_chassis.stl"/></geometry>
      <material name="body"/>
    </visual>
  </link>
  <joint name="top_chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_chassis_link"/>
  </joint>

  <link name="user_rail_link">
    <visual>
      <geometry><mesh filename="meshes/user_rail.stl"/></geometry>
      <material name="accent"/>
    </visual>
  </link>
  <joint name="user_rail" type="fixed">
    <origin xyz="0.272 0 0.245" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="user_rail_link"/>
  </joint>

  <link name="front_bumper_link">
    <visual>
      <geometry><mesh filename="meshes/bumper.stl"/></geometry>
      <material name="accent"/>
    </visual>
  </link>
  <joint name="front_bumper" type="fixed">
    <origin xyz="0.48 0 0.091" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_bumper_link"/>
  </joint>

  <link name="rear_bumper_link">
    <visual>
      <geometry><mesh filename="meshes/bumper.stl"/></geometry>
      <material name="accent"/>
    </visual>
  </link>
  <joint name="rear_bumper" type="fixed">
    <origin xyz="-0.48 0 0.091" rpy="0 0 3.14159"/>
    <parent link="base_link"/>
    <child link="rear_bumper_link"/>
  </joint>

  <link name="top_plate_link">
    <visual>
      <geometry><mesh filename="meshes/top_plate.stl"/></geometry>
      <material name="body"/>
    </visual>
  </link>
  <joint name="top_plate_joint" type="fixed">
    <origin xyz="0.0812 0 0.245" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="top_plate_link"/>
  </joint>

  <link name="front_left_wheel">
    <visual>
      <geometry><mesh filename="meshes/wheel.stl"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0.256 0.2854 0.03282" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <geometry><mesh filename="meshes/wheel.stl"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0.256 -0.2854 0.03282" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_left_wheel">
    <visual>
      <geometry><mesh filename="meshes/wheel.stl"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <origin xyz="-0.256 0.2854 0.03282" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_right_wheel">
    <visual>
      <geometry><mesh filename="meshes/wheel.stl"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <origin xyz="-0.256 -0.2854 0.03282" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>
</robot>
